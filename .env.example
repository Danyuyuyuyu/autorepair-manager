# ============================================================
# 汽修管家 - 环境变量模板
# 复制为 .env 后按实际环境修改
# ============================================================

# PostgreSQL 连接串（生产环境使用 docker-compose 中的 db 服务）
DATABASE_URL="postgresql://autorepair:autorepair_pwd@localhost:5432/autorepair?schema=public"

# 会话签名密钥（生产环境必须替换为随机 32 字节以上字符串）
# 生成方式: openssl rand -base64 48
AUTH_SECRET="please-change-me-to-a-random-32-bytes-secret-string"

# 会话有效期（天）
SESSION_TTL_DAYS="7"

# 会话 Cookie 是否强制 Secure（仅 HTTPS 下发）。生产环境默认开启。
# 手机 / 平板在局域网通过 http://<内网IP>:3000 访问时必须设为 "false"，
# 否则浏览器丢弃会话 Cookie，登录后会立刻被弹回登录页。
# 公网 / HTTPS 反代部署请保持 "true"。
AUTH_COOKIE_SECURE="true"

# 应用信息
NEXT_PUBLIC_APP_NAME="汽车维修店管理系统"
NEXT_PUBLIC_APP_SHORT_NAME="汽修管家"

# SQLite 正式首次启动管理员（只在真正空库时读取；初始化完成后不会覆盖账号）
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="店长"

# PostgreSQL 开发 fixture（pnpm db:seed；包含演示数据，禁止用于正式首次启动）
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123456"
SEED_ADMIN_NAME="店长"
