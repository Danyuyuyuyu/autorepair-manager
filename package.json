{
  "name": "autorepair-manager",
  "version": "1.0.0",
  "private": true,
  "description": "汽修管家 - 汽车维修店记账管理系统（Mobile First）",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm prisma:validate",
    "smoke": "node --conditions=react-server --import tsx scripts/smoke-test.ts",
    "smoke:postgres": "node scripts/run-with-storage.mjs postgres",
    "smoke:sqlite": "node scripts/run-with-storage.mjs sqlite",
    "sqlite:verify": "node --import tsx scripts/sqlite-verify.ts",
    "fresh-install:verify": "node --conditions=react-server --import tsx scripts/fresh-install-verify.ts",
    "storage:verify": "node --import tsx scripts/storage-verify.ts",
    "work-order:contract": "node --conditions=react-server --import tsx scripts/work-order-repository-contract.ts",
    "customer:contract": "node --conditions=react-server --import tsx scripts/customer-repository-contract.ts",
    "vehicle:contract": "node --conditions=react-server --import tsx scripts/vehicle-repository-contract.ts",
    "part:contract": "node --conditions=react-server --import tsx scripts/part-repository-contract.ts",
    "inventory:contract": "node --conditions=react-server --import tsx scripts/inventory-repository-contract.ts",
    "finance:contract": "node --conditions=react-server --import tsx scripts/finance-repository-contract.ts",
    "catalog:contract": "node --conditions=react-server --import tsx scripts/catalog-repository-contract.ts",
    "user:contract": "node --conditions=react-server --import tsx scripts/user-repository-contract.ts",
    "audit:contract": "node --conditions=react-server --import tsx scripts/audit-repository-contract.ts",
    "sqlite:user-login": "node --conditions=react-server --import tsx scripts/sqlite-user-login-probe.ts",
    "sqlite:audit": "node --conditions=react-server --import tsx scripts/sqlite-audit-probe.ts",
    "sqlite:auth-probe": "node --conditions=react-server --import tsx scripts/sqlite-auth-probe.ts",
    "sqlite:session-prune": "node --conditions=react-server --import tsx scripts/sqlite-session-prune-probe.ts",
    "session:contract": "node --conditions=react-server --import tsx scripts/session-store-contract.ts",
    "session:prune": "node --conditions=react-server --import tsx scripts/prune-sessions.ts",
    "backup": "node --conditions=react-server --import tsx scripts/backup.ts",
    "migrate:postgres-to-sqlite": "node --conditions=react-server --import tsx scripts/migrate-postgres-to-sqlite.ts",
    "backup:contract": "node --conditions=react-server --import tsx scripts/backup-contract.ts",
    "animation:contract": "node --conditions=react-server --import tsx scripts/animation-contract.ts",
    "plate:contract": "node --import tsx scripts/plate-suggest-contract.ts",
    "e2e:plate": "node --import tsx scripts/e2e-work-order-plate.ts",
    "e2e:fresh-install": "node --conditions=react-server --import tsx scripts/e2e-fresh-install.ts",
    "mobile:dev": "pnpm --dir apps/mobile dev",
    "mobile:build": "pnpm --dir apps/mobile build",
    "mobile:sync": "pnpm mobile:build && pnpm --dir apps/mobile exec cap sync android",
    "mobile:doctor": "node scripts/mobile-doctor.mjs",
    "mobile:android:build": "pnpm mobile:sync && pnpm --dir apps/mobile android:build",
    "mobile:sqlite:verify": "node scripts/mobile-sqlite-verify.mjs",
    "mobile:deps:verify": "node scripts/mobile-import-guard.mjs",
    "mobile:shell:verify": "node --import tsx scripts/e2e-mobile-shell.ts",
    "session:prune-contract": "node --conditions=react-server --import tsx scripts/session-prune-contract.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:start": "node scripts/dev-db.mjs start",
    "db:stop": "node scripts/dev-db.mjs stop"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.5.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "18.1.0-beta.15",
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "18.1.0-beta.15",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.25",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
